<%- include("partials/header") %>

<div class="text-center mb-4">
  <h3 class="fw-bold">Waiting Room</h3>
  <span id="status" class="badge bg-secondary">Connecting...</span>
</div>

<div class="card shadow-sm mx-auto" style="max-width: 600px;">
  <table class="table mb-0 text-center align-middle">
    <thead class="table-light">
      <tr><th>Token</th><th>Patient</th><th>Status</th></tr>
    </thead>
    <tbody id="queue">
      <tr><td colspan="3" class="text-muted">Loading...</td></tr>
    </tbody>
  </table>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
  const doctorId = "<%= doctorId %>";
  const tbody = document.getElementById("queue");
  const statusBadge = document.getElementById("status");

  function render(tokens) {
    if (!tokens.length) {
      tbody.innerHTML = '<tr><td colspan="3" class="text-muted">Queue empty</td></tr>';
      return;
    }
    tbody.innerHTML = tokens.map(t => `
      <tr>
        <td style="font-size: 20px; font-weight: bold;">#${t.number}</td>
        <td>${t.patient ? t.patient.name : "-"}</td>
        <td>
          <span class="badge ${t.status === "claimed" ? "bg-success" : "bg-warning text-dark"}">
            ${t.status === "claimed" ? "Now with doctor" : "Waiting"}
          </span>
        </td>
      </tr>`).join("");
  }

  // Pahilyanda current queue anun dakhav
  fetch("/tokens/queue/" + doctorId).then(r => r.json()).then(render);

  // Live updates
  const socket = io();
  socket.on("connect", () => {
    socket.emit("joinDoctor", doctorId);
    statusBadge.textContent = "Live";
    statusBadge.className = "badge bg-success";
  });
  socket.on("disconnect", () => {
    statusBadge.textContent = "Disconnected";
    statusBadge.className = "badge bg-danger";
  });
  socket.on("queue:update", render);
</script>

<%- include("partials/footer") %>